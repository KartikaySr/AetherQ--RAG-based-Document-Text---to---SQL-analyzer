NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
# Optional persistent writable directory for local MiniLM weights. Defaults to the OS temp directory.
EMBEDDING_CACHE_DIR=
# Dedicated analytics database, logging in as aetherq_reader. Never use admin credentials.
ANALYTICS_DATABASE_URL=
# Explicitly authorized Supabase user UUIDs, comma separated. Anonymous users are denied.
ANALYTICS_ALLOWED_USER_IDS=
# App uploads are capped at 4 MB to fit Vercel multipart request limits; storage has a 10 MB backstop.
# Enable anonymous auth in Supabase only if guest sessions are desired.
