# =============================================================================
# AetherQ — copy to `.env.local` and fill values (never commit `.env.local`).
# =============================================================================

# --- Supabase (required) ---
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: service role for server-side SQL audit logs (`query_audit_logs`).
# Without it, audit logging is skipped; app still runs.
SUPABASE_SERVICE_ROLE_KEY=

# --- Public site URL (recommended in production) ---
# Exact origin, no trailing slash — used for metadataBase in layout.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Groq (required for chat, Text-to-SQL, document QA streaming) ---
GROQ_API_KEY=
# Optional override (default: llama-3.3-70b-versatile)
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# --- Hugging Face (required for embeddings / semantic search) ---
# Inference / router token with access to feature-extraction for the model below.
HUGGINGFACE_API_KEY=
# Optional: full URL if you use a different inference router or pinned model.
# Must produce 384-dimensional vectors to match `vector(384)` in Supabase.
# HUGGINGFACE_EMBEDDING_URL=

# --- Warehouse analytics (required for SQL mode + KPI dashboard) ---
# Prefer Supabase → Settings → Database → Connection string (URI), pooler or direct.
DATABASE_URL=
# Use "1" only for local Postgres without TLS
# DATABASE_SSL_DISABLE=0
# Max connections in server pool (default 6, max capped at 20)
# DATABASE_POOL_MAX=6

# --- Upload limits (optional) ---
# NEXT_PUBLIC_MAX_UPLOAD_MB=25
# DOCUMENT_MAX_FILE_MB=25
